              "raw": "{\n  \"apiVersion\": \"<string>\",\n  \"id\": \"<string>\",\n  \"conversationId\": \"<string>\",\n  \"firstName\": \"<string>\",\n  \"email\": \"<string>\",\n  \"leadSource\": \"<string>\",\n  \"repName\": \"<string>\",\n  \"leadStatus\": \"<string>\",\n  \"optOut\": \"<boolean>\",\n  \"repId\": \"<string>\",\n  \"repEmail\": \"<string>\",\n  \"clientId\": \"<string>\",\n  \"lastName\": \"<string>\",\n  \"homePhone\": \"<string>\",\n  \"workPhone\": \"<string>\",\n  \"cellPhone\": \"<string>\",\n  \"address\": \"<string>\",\n  \"city\": \"<string>\",\n  \"state\": \"<string>\",\n  \"zip\": \"<string>\",\n  \"leadType\": \"<string>\",\n  \"date\": \"<dateTime>\",\n  \"smsOptOut\": \"<boolean>\",\n  \"smsOptIn\": \"<boolean>\",\n  \"stopMessaging\": \"<boolean>\",\n  \"skipToFollowup\": \"<boolean>\",\n  \"leadSubStatus\": \"<string>\",\n  \"appointmentStatus\": \"<string>\",\n  \"appointmentDate\": \"<dateTime>\",\n  \"bdcRepId\": \"<string>\",\n  \"bdcRepName\": \"<string>\",\n  \"bdcRepEmail\": \"<string>\",\n  \"serviceRepId\": \"<string>\",\n  \"serviceRepName\": \"<string>\",\n  \"serviceRepEmail\": \"<string>\",\n  \"year\": \"<string>\",\n  \"make\": \"<string>\",\n  \"model\": \"<string>\",\n  \"vin\": \"<string>\"\n}",
